# 复制为 .env 后按需修改。.env 已被 .gitignore 排除，不会进仓库。

# ---------- 数据库（对应 docker-compose.yml 的 3307 端口）----------
DATABASE_URL=mysql+pymysql://root:test123456@127.0.0.1:3307/test_platform?charset=utf8mb4

# ---------- JWT ----------
JWT_SECRET=dev-secret-please-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---------- AI（真实 key 只写进 .env，绝不提交）----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173
